{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "SnapPin",
  "mainBinaryName": "SnapPin",
  "version": "0.1.8",
  "identifier": "com.snappin.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/snappin/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../models/ocr/det.onnx": "models/ocr/det.onnx",
      "../models/ocr/rec.onnx": "models/ocr/rec.onnx",
      "../models/ocr/ppocr_keys_v1.txt": "models/ocr/ppocr_keys_v1.txt"
    }
  }
}
